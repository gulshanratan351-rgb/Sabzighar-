# ------------------------------------------------------------------
# SabziGhar Backend Environment Variables
# Copy this file to `.env` and fill in real values.
# ------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/sabzighar
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/sabzighar
MONGO_URI=mongodb://127.0.0.1:27017/sabzighar

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRE=30d

# Owner / Admin — ONLY this Gmail can log in to the admin panel.
OWNER_EMAIL=youradmin@gmail.com
OWNER_PASSWORD=Admin@12345
OWNER_NAME=SabziGhar Owner

# CORS — comma separated list of allowed frontend origins
CLIENT_URLS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Public base URL of this backend (used to build image URLs)
SERVER_URL=http://localhost:5000

# Business config
DELIVERY_CHARGE=25
FREE_DELIVERY_ABOVE=299
